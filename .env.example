# xPository Environment Variables Example
# Copy this file to .env and customize for your environment
# Note: .env files should NEVER be committed to version control

# ============================================
# Spring Profile Selection
# ============================================
# Options: dev, test, prod
SPRING_PROFILES_ACTIVE=dev

# ============================================
# Production Configuration (prod profile)
# ============================================

# Server Configuration
SERVER_PORT=8080

# Database Configuration
# For production, consider using PostgreSQL instead of SQLite
DATABASE_PATH=/var/lib/xpository/xpository.db

# Hibernate Search Index Location
INDEX_PATH=/var/lib/xpository/indexes

# Element Type Definitions Location
CONFIG_PATH=/etc/xpository

# ============================================
# Security Configuration (Future Implementation)
# ============================================
# JWT_SECRET=your-secret-key-here
# JWT_EXPIRATION_MS=86400000

# ============================================
# External Services (Future Implementation)
# ============================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your-username
# SMTP_PASSWORD=your-password

# ============================================
# Logging Configuration
# ============================================
# Root log level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# Log file location (prod profile only)
LOG_PATH=/var/log/xpository

# ============================================
# Monitoring & Metrics (Future Implementation)
# ============================================
# ACTUATOR_USERNAME=admin
# ACTUATOR_PASSWORD=change-me-in-production
